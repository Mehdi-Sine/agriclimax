                  "represented_area_m2": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "expected_days": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "available_days": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "continuous": {
                    "type": "boolean"
                  },
                  "homogeneous": {
                    "type": "boolean"
                  },
                  "method": {
                    "type": "string"
                  },
                  "estimate_certificate": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reference_compatible": {
                    "type": "boolean"
                  }
                }
