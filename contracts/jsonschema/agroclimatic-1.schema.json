                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fraction",
                  "support_id",
                  "mask",
                  "represented_area_m2",
                  "expected_days",
                  "available_days",
                  "continuous",
                  "homogeneous",
                  "method",
                  "estimate_certificate",
                  "reference_compatible"
