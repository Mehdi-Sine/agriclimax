                  "type": [
                    "string",
                    "null"
                  ]
                },
                "run": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "nature": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "temperature": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "support_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
