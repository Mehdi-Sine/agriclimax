{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agriclimax:multiproduction-registry:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "productions", "recipes"],
  "properties": {
    "version": { "const": "multiproduction-descriptive-1.0.0" },
    "productions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "family", "indicators", "limits"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "family": { "type": "string", "minLength": 1 },
          "indicators": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "limits": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "classification",
          "kernel",
          "windows",
          "natures",
          "editorial"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "classification": {
            "enum": [
              "meteorological",
              "agroclimatic_descriptive",
              "agronomic_interpretative"
            ]
          },
          "editorial": { "const": "qualified_descriptive_only" },
          "windows": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1, "maximum": 30 }
          },
          "natures": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["observation", "reanalysis", "forecast"] }
          },
          "kernel": {
            "type": "object",
            "required": [
              "id",
              "version",
              "variables",
              "operator",
              "threshold",
              "formula",
              "unit",
              "source",
              "scientific_status",
              "quality",
              "limits",
              "coverage_family"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "version": { "const": "multiproduction-descriptive-1.0.0" },
              "variables": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "temperature",
                    "temperature_min",
                    "temperature_max",
                    "precipitation",
                    "humidity"
                  ]
                }
              },
              "operator": {
                "enum": [
                  "min",
                  "mean",
                  "gdd",
                  "above",
                  "below",
                  "sum",
                  "longestAbove",
                  "longestBelow",
                  "thi",
                  "thiAbove",
                  "thiLongest"
                ]
              },
              "threshold": { "type": ["number", "null"] },
              "formula": { "type": "string", "minLength": 1 },
              "unit": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "scientific_status": { "const": "exploratory" },
              "quality": { "type": "string", "minLength": 1 },
              "limits": { "type": "string", "minLength": 1 },
              "coverage_family": {
                "enum": [
                  "mean_sum",
                  "extreme_event",
                  "sequence",
                  "normal_anomaly",
                  "specific"
                ]
              }
            }
          }
        }
      }
    }
  }
}
