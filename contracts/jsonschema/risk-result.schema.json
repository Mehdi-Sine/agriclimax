{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agriclimax.local/contracts/risk-result/v1",
  "title": "RiskResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cell_id",
    "valid_date",
    "production_id",
    "indicator_id",
    "hazard",
    "risk",
    "confidence",
    "rule",
    "provenance",
    "quality"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "cell_id": {
      "type": "string"
    },
    "valid_date": {
      "type": "string",
      "format": "date"
    },
    "production_id": {
      "type": "string"
    },
    "indicator_id": {
      "type": "string"
    },
    "hazard": {
      "type": "object",
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "class": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "exposure": {
      "type": [
        "object",
        "null"
      ]
    },
    "sensitivity": {
      "type": [
        "object",
        "null"
      ]
    },
    "risk": {
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "enum": [
            "low",
            "moderate",
            "high",
            "critical",
            "unavailable"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
      "required": [
        "level",
        "scientific_status"
      ],
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "scientific_status": {
          "enum": [
            "exploratory",
            "documented",
            "expert_reviewed",
            "validated",
            "deprecated"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": [
        "rule_id",
        "version"
      ],
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "freshness",
        "flags"
      ],
      "properties": {
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
