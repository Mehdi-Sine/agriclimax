 pnpm audit --audit-level high --json # exit 1: braces
 pip-audit --strict --disable-pip --no-deps -r engine/requirements-dev.lock # pytest, baseline current main identical
 pip-audit --strict --disable-pip --no-deps -r scripts/quality/requirements.lock
 npm audit --prefix tests/e2e --audit-level high
