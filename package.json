{
  "name": "agriclimax",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @agriclimax/web dev",
    "build": "pnpm --filter @agriclimax/web build",
    "typecheck": "pnpm --filter @agriclimax/web typecheck",
    "test": "pnpm --filter @agriclimax/web test",
    "lint": "pnpm --filter @agriclimax/web lint",
    "check-contracts": "python scripts/check_contracts.py",
    "check-security": "python scripts/quality/security.py",
    "check-bundle": "python scripts/quality/security.py --bundle apps/web/.next/static",
    "check-migrations": "python scripts/quality/migrations.py",
    "check-budget": "python scripts/quality/budget.py",
    "test-quality": "python -m unittest discover -s tests/quality -p 'test_*.py' -v && node --test tests/quality/*.test.mjs",
    "test-e2e": "node tests/e2e/demo.mjs",
    "test-integration": "node tests/e2e/integration.mjs",
    "smoke": "python scripts/quality/smoke.py",
    "test-e2e-live": "node tests/e2e/live-risk.mjs",
    "test-e2e-daily": "node tests/e2e/daily-risk.mjs",
    "editorial:generate": "NODE_OPTIONS=--conditions=react-server apps/web/node_modules/.bin/tsx scripts/task33_briefing.ts",
    "editorial:validate": "NODE_OPTIONS=--conditions=react-server apps/web/node_modules/.bin/tsx scripts/task33_briefing.ts --validate",
    "editorial:typecheck": "pnpm --filter @agriclimax/web exec tsc --project ../../scripts/tsconfig.task33.json",
    "editorial-ai:generate": "NODE_OPTIONS=--conditions=react-server apps/web/node_modules/.bin/tsx scripts/task35_editorial.ts",
    "editorial-ai:typecheck": "pnpm --filter @agriclimax/web exec tsc --project ../../scripts/tsconfig.task35.json",
    "editorial-ai:live": "NODE_OPTIONS=--conditions=react-server apps/web/node_modules/.bin/tsx scripts/task35b_live.ts"
  },
  "engines": {
    "node": ">=20.9",
    "pnpm": "10.x"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": ["GHSA-vfj7-8cjw-p6xm"]
    },
    "overrides": {
      "ajv>fast-uri": "3.1.9",
      "vitest": "4.1.12",
      "tinypool": "2.1.2"
    }
  }
}
